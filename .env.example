# SQLite 数据目录，必须使用绝对路径；留空时使用应用默认目录。
RESUME_LIFE_DATA_DIR=

# 允许访问应用的 Host，多个值用逗号分隔；本机使用时通常留空。
RESUME_LIFE_ALLOWED_HOSTS=

# HTTPS 反向代理部署时设为 true，统一给会话 Cookie 添加 Secure；本机 HTTP 留空。
RESUME_LIFE_SECURE_COOKIES=

# 忘记密码的逃生门：置为 true 后重启，可在登录页重新初始化用户名和密码；完成后务必改回留空。
RESUME_LIFE_AUTH_REINIT=

# AI API Key 与代理密码的应用级加密密钥；所有非测试运行（含 npm run dev）保存凭证前必填。
# 使用随机高熵值、重启时沿用同一值，并与数据库/备份分开保管；它不是模型服务 API Key。
RESUME_LIFE_SETTINGS_KEY=

# OCR 语言包目录，必须使用绝对路径；留空时使用当前工作目录。
RESUME_LIFE_OCR_DATA_DIR=
