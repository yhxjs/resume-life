{
  "name": "resume-life",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "predev": "node scripts/check-runtime.mjs",
    "prebuild": "node scripts/check-runtime.mjs",
    "prestart": "node scripts/check-runtime.mjs",
    "pretest": "node scripts/check-runtime.mjs",
    "pretest:coverage": "node scripts/check-runtime.mjs",
    "dev": "cross-env NODE_OPTIONS=--experimental-sqlite next dev --hostname 127.0.0.1 --port 3714",
    "build": "cross-env NODE_OPTIONS=--experimental-sqlite next build",
    "start": "cross-env NODE_OPTIONS=--experimental-sqlite next start --hostname 127.0.0.1 --port 3714",
    "lint": "eslint",
    "test": "cross-env NODE_OPTIONS=--experimental-sqlite vitest run",
    "test:coverage": "cross-env NODE_OPTIONS=--experimental-sqlite vitest run --coverage",
    "check:page-coverage": "node scripts/check-page-coverage.mjs",
    "check:interview-reminders": "node src/lib/check-interview-reminders.mjs",
    "check:public-assets": "node scripts/check-public-assets.mjs",
    "setup:ocr": "node scripts/prepare-ocr.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test:e2e": "playwright test",
    "check:build-trace": "node scripts/check-build-trace.mjs",
    "check:release": "npm run check:public-assets && npm test && npm run lint && npm run typecheck && npm run build && npm run check:build-trace && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@napi-rs/canvas": "0.1.80",
    "busboy": "1.6.0",
    "docx": "9.7.2",
    "fetch-socks": "^1.3.3",
    "mammoth": "1.13.0",
    "next": "16.4.0",
    "pdf-parse": "2.4.5",
    "pdfjs-dist": "5.4.296",
    "playwright-core": "1.63.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.5",
    "tesseract.js": "5.1.1",
    "undici": "^7.30.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/busboy": "1.5.4",
    "@types/node": "24.10.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "4.1.11",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "fast-glob": "file:./vendor/next-eslint-glob",
    "jsdom": "30.1.1",
    "jszip": "3.10.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.11"
  },
  "overrides": {
    "@next/eslint-plugin-next": {
      "fast-glob": "$fast-glob"
    },
    "source-map-js": "1.2.2",
    "mammoth": {
      "argparse": "2.0.1"
    }
  }
}
